# Raw facsimiles and everything regenerable from them
data/raw/
data/ia/
data/pages/
data/ocr/

# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Review sheets are regenerable from the sample manifest
data/adjudication/sample_sheet_*.png
data/adjudication/sample_round*_sheet_*.png
data/adjudication/p0*/

# The readable transcription (data/text/*.txt) is committed; the per-word
# sidecars carrying every word's box and certainty tier are 100 MB and come
# straight back out of build_text.py.
data/text/*.json

# HTR training material: line crops and compiled datasets, both regenerable
data/htr/
.venv-htr/
models/

# Review decisions are data -- they are the human's work and are committed.
# Nothing under data/review/ is regenerable.

# Review batch sheets are scratch: regenerable from the queue in one command.
# data/review/decisions.jsonl is not -- it is the adjudication itself.
data/review/batch*.png
data/review/batch*.json

# The database is derived: scripts/build_db.py rebuilds it from data/ in
# seconds. db/schema.sql is the part that is not derived and is committed,
# as in the sibling projects.
db/*.duckdb
db/*.duckdb.wal
